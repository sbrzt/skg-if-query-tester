<https://w3id.org/oc/meta/br/061302582354> a fabio:ScholarlyWork,
        fabio:Work ;
    frapo:isFundedBy <https://api.openaire.eu/graph/skg-if/v1/grants/501100001584::1e5e62235d094afd01cd56e65112fc63>,
