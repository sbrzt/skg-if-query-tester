# id: CQ_054_b
# question:
#   Which outputs in the system are classified under Library and Information Science?


PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX fabio: <http://purl.org/spar/fabio/>
PREFIX frbr: <http://purl.org/vocab/frbr/core#>
PREFIX lcc: <http://id.loc.gov/authorities/classification/>


SELECT DISTINCT ?work (MIN(?t) AS ?title)
WHERE {
    ?work a fabio:Work ;
        frbr:realization [
            dcat:accessService ?ds
        ] .
    ?ds a dcat:DataService ;
        dcterms:subject lcc:Z .
            
    OPTIONAL { ?work dcterms:title ?t }
}
GROUP BY ?work

### changed the logic: instead of starting from dcat:DataService, we start from fabio:Work
### from the work we go to its manifestation, then to the data source, then to dcterms:subject
### odrl:hasPolicy and odrl:hasTarget were not necessary

### had to add lcc:Z manually
### added MIN for deterministic pick of titles, since there could be multiple
### no field "disciplines" to materialize