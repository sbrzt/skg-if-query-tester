### removed LCASE and changed keyword string to "H2020"
### added the keywords manually
### !IMPORTANT! MODEL REQUIRES EXTENSION DUE TO prism:keyword TO WORK

## ALTERNATIVE: use the Topic pattern

SELECT DISTINCT ?work (MIN(?t) AS ?title) ?project_name
WHERE {
    ?work a fabio:Work ;
        bido:holdsBibliometricDataInTime [
            bido:withBibliometricData [
                skos:prefLabel ?keyword
            ]
        ] ;
        dcterms:title ?t ;
        frapo:isFundedBy ?grant .
    ?grant a frapo:Grant ;
        frapo:hasCallIdentifier ?call .
    FILTER ( LCASE(STR(?keyword)) IN (
        "power", "poverty"
    ) )
    FILTER ( CONTAINS(STR(?call), "H2020") )
    OPTIONAL { ?grant frapo:hasAcronym ?grant_acronym }
    OPTIONAL { ?grant dcterms:title ?grant_title }
    BIND ( COALESCE(?grant_acronym, ?grant_title) AS ?project_name )
}
GROUP BY ?work ?project_name

### removed LCASE for ?call and changed keyword string to "H2020"
### added MIN for deterministic pick of titles, since there could be multiple
### added the keywords manually